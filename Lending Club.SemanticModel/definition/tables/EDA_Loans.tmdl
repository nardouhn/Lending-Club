	column nhom_muc_dich_tt
		dataType: int64
		isHidden
		lineageTag: 607fbd0f-4c47-4e79-9300-4ece69c5c1cf
		summarizeBy: none
		sourceColumn: nhom_muc_dich_tt

	partition EDA_Loans = m
		mode: import
		source =
				let
					Nguon = Parquet.Document(File.Contents(EDA_DuongDanFile)),
				
					GiuCot = Table.SelectColumns(Nguon, {
						"issue_d", "term", "funded_amnt", "annual_inc", "dti", "emp_length",
						"home_ownership", "purpose", "fico_range_low", "grade", "int_rate",
						"loan_status", "total_pymnt", "collection_recovery_fee"}),
				
					LamSachChu = Table.TransformColumns(GiuCot, {
						{"issue_d",        each Text.Trim(Text.From(_)), type text},
						{"term",           each Text.Trim(Text.From(_)), type text},
						{"emp_length",     each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
						{"home_ownership", each Text.Trim(Text.From(_)), type text},
						{"purpose",        each Text.Trim(Text.From(_)), type text},
						{"grade",          each Text.Trim(Text.From(_)), type text},
						{"loan_status",    each Text.Trim(Text.From(_)), type text}}),
				
					KieuSo = Table.TransformColumnTypes(LamSachChu, {
						{"funded_amnt", type number}, {"annual_inc", type number}, {"dti", type number},
						{"fico_range_low", type number}, {"int_rate", type number},
						{"total_pymnt", type number}, {"collection_recovery_fee", type number}}),
				
					// ---- thời gian, kỳ hạn
					Ngay   = Table.AddColumn(KieuSo, "ngay_phat_hanh", each
								Date.FromText("01-" & [issue_d], [Format = "dd-MMM-yyyy", Culture = "en-US"]), type date),
					Nam    = Table.AddColumn(Ngay, "nam", each Date.Year([ngay_phat_hanh]), Int64.Type),
					Quy    = Table.AddColumn(Nam, "quy", each
								Text.From([nam]) & "-Q" & Text.From(Date.QuarterOfYear([ngay_phat_hanh])), type text),
					KyHan  = Table.AddColumn(Quy, "term_thang", each Number.From(Text.Select([term], {"0".."9"})), Int64.Type),
				
					// ---- trạng thái và kết cục
					// 'Default' KHÔNG phải trạng thái kết thúc (out_prncp còn khác 0) -> xếp vào Trễ hạn
					NhomTT = Table.AddColumn(KyHan, "nhom_trang_thai", each
								if [loan_status] = "Fully Paid" then "Trả đủ"
								else if [loan_status] = "Charged Off" then "Xóa nợ"
								else if [loan_status] = "Current" then "Đang trả"
								else if Text.StartsWith([loan_status], "Does not meet") then "Ngoại lệ chính sách"
								else "Trễ hạn", type text),
					NhomTTtt = Table.AddColumn(NhomTT, "nhom_trang_thai_tt", each
								List.PositionOf({"Trả đủ", "Xóa nợ", "Trễ hạn", "Đang trả", "Ngoại lệ chính sách"},
												[nhom_trang_thai]) + 1, Int64.Type),
					KetThuc = Table.AddColumn(NhomTTtt, "da_ket_thuc", each
								if List.Contains({"Fully Paid", "Charged Off"}, [loan_status]) then 1 else 0, Int64.Type),
					VoNo    = Table.AddColumn(KetThuc, "default", each
								if [da_ket_thuc] = 1 then (if [loan_status] = "Charged Off" then 1 else 0) else null,
								type nullable number),
					PhamVi  = Table.AddColumn(VoNo, "pham_vi_rui_ro", each
								if [term_thang] = 36 and [nam] >= 2013 and [nam] <= 2015 and [da_ket_thuc] = 1
								then 1 else 0, Int64.Type),
				
					// ---- lợi nhuận và lãi suất (null -> 0)
					LoiNhuan = Table.AddColumn(PhamVi, "loi_nhuan", each
								(if [total_pymnt] = null then 0 else [total_pymnt])
							- (if [collection_recovery_fee] = null then 0 else [collection_recovery_fee])
							- (if [funded_amnt] = null then 0 else [funded_amnt]), type number),
					LaiSuat  = Table.AddColumn(LoiNhuan, "lai_suat", each [int_rate] / 100, type number),
					NhomHang = Table.AddColumn(LaiSuat, "nhom_hang", each
								if List.Contains({"A", "B"}, [grade]) then "A–B"
								else if List.Contains({"C", "D"}, [grade]) then "C–D"
								else "E–G", type text),
				
					// ---- chia dải: khoảng [a, b), giá trị âm hoặc null -> null
					ThuTu = (x as nullable number, moc as list) as nullable number =>
						if x = null or x < 0 then null else List.Count(List.Select(moc, (m) => m <= x)) + 1,
					ThemDai = (bang as table, nguon as text, ten as text, moc as list, nhan as list) as table =>
						let
							b1 = Table.AddColumn(bang, ten & "_tt", each ThuTu(Record.Field(_, nguon), moc), Int64.Type),
							b2 = Table.AddColumn(b1, ten, each
									let k = Record.Field(_, ten & "_tt") in if k = null then null else nhan{k - 1},
									type nullable text)
						in b2,
				
					DaiFico = ThemDai(NhomHang, "fico_range_low", "dai_fico", {660, 680, 700, 720, 740, 780},
								{"Dưới 660", "660–680", "680–700", "700–720", "720–740", "740–780", "Từ 780"}),
					DaiDti  = ThemDai(DaiFico, "dti", "dai_dti", {10, 15, 20, 25, 30, 35},
								{"0–10", "10–15", "15–20", "20–25", "25–30", "30–35", "Từ 35"}),
					DaiTN   = ThemDai(DaiDti, "annual_inc", "dai_thu_nhap", {40000, 60000, 80000, 100000, 150000},
								{"Dưới 40k", "40–60k", "60–80k", "80–100k", "100–150k", "Từ 150k"}),
				
					// ---- hồ sơ người vay
					ThamNien = Table.AddColumn(DaiTN, "nhom_tham_nien", each
								let e = [emp_length] in
								if e = null or e = "" or e = "n/a" then "Không khai"
								else if e = "< 1 year" then "Dưới 1 năm"
								else if e = "10+ years" then "Từ 10 năm"
								else if Number.From(Text.BeforeDelimiter(e, " ")) <= 4 then "1–4 năm"
								else "5–9 năm", type text),
					ThamNienTT = Table.AddColumn(ThamNien, "nhom_tham_nien_tt", each
								List.PositionOf({"Dưới 1 năm", "1–4 năm", "5–9 năm", "Từ 10 năm", "Không khai"},
												[nhom_tham_nien]) + 1, Int64.Type),
					NhaO = Table.AddColumn(ThamNienTT, "nhom_nha_o", each
								if [home_ownership] = "MORTGAGE" then "Thế chấp"
								else if [home_ownership] = "RENT" then "Thuê"
								else if [home_ownership] = "OWN" then "Sở hữu"
								else "Khác", type text),
					MucDich = Table.AddColumn(NhaO, "nhom_muc_dich", each
								if [purpose] = null then "Khác" else
								Record.FieldOrDefault([
									debt_consolidation = "Hợp nhất nợ", credit_card = "Trả nợ thẻ",
									home_improvement = "Sửa nhà", major_purchase = "Mua sắm lớn",
									car = "Mua xe", small_business = "Kinh doanh nhỏ"], [purpose], "Khác"), type text),
				
					// ---- cột phục vụ bản v2 của 2 trang
					KetCuc = Table.AddColumn(MucDich, "ket_cuc", each
								if [loan_status] = "Fully Paid"
								or [loan_status] = "Does not meet the credit policy. Status:Fully Paid" then "Trả đủ"
								else if [loan_status] = "Charged Off"
								or [loan_status] = "Does not meet the credit policy. Status:Charged Off" then "Xóa nợ"
								else "Chưa kết thúc", type text),
					KetCucTT = Table.AddColumn(KetCuc, "ket_cuc_tt", each
								List.PositionOf({"Trả đủ", "Xóa nợ", "Chưa kết thúc"}, [ket_cuc]) + 1, Int64.Type),
					QuyBatDau = Table.AddColumn(KetCucTT, "quy_bat_dau", each
								#date([nam], (Date.QuarterOfYear([ngay_phat_hanh]) - 1) * 3 + 1, 1), type date),
					// nhóm danh nghĩa: thứ tự theo tỷ lệ vỡ nợ giảm dần (đo trên phạm vi B, xem scripts/so_ky_vong_eda.txt)
					NhaOTT = Table.AddColumn(QuyBatDau, "nhom_nha_o_tt", each
								List.PositionOf({"Thuê", "Sở hữu", "Thế chấp", "Khác"}, [nhom_nha_o]) + 1, Int64.Type),
					MucDichTT = Table.AddColumn(NhaOTT, "nhom_muc_dich_tt", each
								List.PositionOf({"Kinh doanh nhỏ", "Khác", "Hợp nhất nợ", "Mua sắm lớn",
												"Sửa nhà", "Mua xe", "Trả nợ thẻ"}, [nhom_muc_dich]) + 1, Int64.Type),
				
					BoCot = Table.RemoveColumns(MucDichTT, {
						"issue_d", "term", "int_rate", "emp_length", "home_ownership", "purpose",
						"loan_status", "total_pymnt", "collection_recovery_fee"})
				in
					BoCot

