table EDA_Loans
	lineageTag: fc205ec7-b699-4ff4-8106-71c9ac2996a7

	measure 'EDA Số khoản' = COUNTROWS ( EDA_Loans )
		formatString: #,0
		displayFolder: EDA
		lineageTag: c79a9b70-bab7-4ab5-8c7c-d6c9fdb44202

	measure 'EDA % đã biết kết cục' = DIVIDE ( CALCULATE ( [EDA Số khoản], EDA_Loans[da_ket_thuc] = 1 ), [EDA Số khoản] )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: 99f8bc90-681a-411b-a261-a6cc301fe008

	measure 'EDA Số khoản phạm vi' = CALCULATE ( [EDA Số khoản], EDA_Loans[pham_vi_rui_ro] = 1 )
		formatString: #,0
		displayFolder: EDA
		lineageTag: e241b55e-58bf-4ef7-915a-6c2ef0048c7d

	/// ROI theo vốn = (tổng thu - phí thu hồi - vốn giải ngân) / vốn giải ngân, tự áp phạm vi B
	measure 'EDA ROI theo vốn' =
			CALCULATE (
				DIVIDE ( SUM ( EDA_Loans[loi_nhuan] ), SUM ( EDA_Loans[funded_amnt] ) ),
				EDA_Loans[pham_vi_rui_ro] = 1
			)
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: 96d93b0f-085d-4504-9c8f-2f40e04f548e

	measure 'EDA Lãi suất TB' = CALCULATE ( AVERAGE ( EDA_Loans[lai_suat] ), EDA_Loans[pham_vi_rui_ro] = 1 )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: 11dcf9ea-c2c2-4178-9e8c-2933780a91bc

	measure 'EDA Tỷ trọng' = DIVIDE ( [EDA Số khoản], CALCULATE ( [EDA Số khoản], ALLSELECTED ( EDA_Loans ) ) )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: ecdd72af-ca46-4057-8898-31004d134bd5

	measure 'EDA Vốn giải ngân (tỷ USD)' = DIVIDE ( SUM ( EDA_Loans[funded_amnt] ), 1e9 )
		formatString: 0.0 "tỷ USD"
		displayFolder: EDA
		lineageTag: 2118ebbe-5803-4ab5-9f01-8975f92d09e5

	measure 'EDA Tỷ lệ vỡ nợ' = CALCULATE ( AVERAGE ( EDA_Loans[default] ), EDA_Loans[pham_vi_rui_ro] = 1 )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: 14ef831a-6f4c-4d8c-bba4-c82a3b8c0d70

	/// Ma trận: ô dưới 300 khoản để trống
	measure 'EDA Tỷ lệ vỡ nợ đủ mẫu' = IF ( [EDA Số khoản phạm vi] >= 300, [EDA Tỷ lệ vỡ nợ] )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: 3dfa392c-6d32-41af-aa68-76bb2d6dc22f

	/// Đường tham chiếu: toàn phạm vi B
	measure 'EDA Tỷ lệ vỡ nợ chung' = CALCULATE ( [EDA Tỷ lệ vỡ nợ], REMOVEFILTERS ( EDA_Loans ) )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: bb1c8d1d-d5a3-4d3f-95c2-f238656115c7

	/// Đỏ đô: cao hơn mức chung; xám: còn lại
	measure 'EDA Màu vỡ nợ' =
			
			IF ( [EDA Tỷ lệ vỡ nợ] > [EDA Tỷ lệ vỡ nợ chung], "#64B5BB", "#B6EFF3" )
		formatString: General
		displayFolder: EDA
		lineageTag: 3283be56-9e55-436e-b105-1d5aaa06dc94

	/// Nhãn % cho biểu đồ cơ cấu hạng theo năm (V3); không có trong mục 4 của hướng dẫn
	measure 'EDA Tỷ trọng hạng trong năm' = DIVIDE ( [EDA Số khoản], CALCULATE ( [EDA Số khoản], ALLSELECTED ( EDA_Loans[grade] ) ) )
		formatString: 0.0%
		displayFolder: EDA
		lineageTag: 8a4d4031-6c70-4321-8bc4-f803c2583d22

