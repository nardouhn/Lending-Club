{
  "name": "Projector-Proof Executive Burgundy & Slate",
  "dataColors": [
    "#1E3A8A",
    "#EA580C",
    "#0F766E",
    "#BE185D",
    "#475569",
    "#7C3AED",
    "#991B1B"
  ],
  "background": "#E9EDF2",
  "foreground": "#0F172A",
  "tableAccent": "#991B1B",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "radius": 6
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 32,
            "fontFamily": "Segoe UI",
            "isBold": true
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#334155" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "isBold": true
          }
        ]
      }
    },
    "categoryCard": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 32,
            "fontFamily": "Segoe UI",
            "isBold": true
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#334155" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "isBold": true
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "title": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "isBold": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": { "solid": { "color": "#E9EDF2" } }
          }
        ]
      }
    }
  }
}